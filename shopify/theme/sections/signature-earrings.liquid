{% comment %}
  Signature Earrings — ported from the SIGNATURE EARRINGS block of
  frontend/src/app/page.tsx and components/home/SignatureEarringsGrid.tsx.
  Four cards, odd ones staggered down on desktop, rotating badge labels.
{% endcomment %}
{%- liquid
  assign col = section.settings.collection
  assign badges = section.settings.badges | split: ','
-%}
{%- if col != blank and col.products_count > 0 -%}
  <section class="relative py-24 md:py-32 px-6 md:px-12 overflow-hidden" style="background: #FAF8F5" data-section-id="{{ section.id }}">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-16 sm:mb-20" data-reveal>
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-px" style="background: var(--gold-deep)"></span>
            <p class="eyebrow" style="color: var(--gold-deep)">{{ section.settings.eyebrow }}</p>
          </div>
          <h2 class="serif text-4xl sm:text-5xl md:text-6xl font-light leading-tight">{{ section.settings.heading }}</h2>
        </div>
        <div class="mt-4 md:mt-0 max-w-md">
          <p class="text-xs sm:text-sm opacity-70 leading-relaxed">{{ section.settings.copy }}</p>
        </div>
      </div>

      <div data-reveal>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 items-start">
          {%- for product in col.products limit: 4 -%}
            {%- liquid
              assign primary = product.featured_image
              assign secondary = product.images[1]
              assign variant = product.selected_or_first_available_variant
              assign material = product.metafields.custom.material.value
              assign detail_alt = product.title | append: ' detail'
              assign badge_index = forloop.index0 | modulo: badges.size
              assign badge = badges[badge_index] | strip
              assign stagger = forloop.index0 | modulo: 2
            -%}
            <div class="group relative bg-white border rounded-sm p-5 shadow-sm hover:shadow-2xl transition-all duration-500{% if stagger == 1 %} lg:translate-y-8{% endif %}" style="border-color: rgba(43,38,32,.1)">
              <div class="relative w-full aspect-square overflow-hidden bg-cream rounded-sm mb-5 border" style="border-color: rgba(43,38,32,.08)">
                <a href="{{ product.url }}" class="block w-full h-full relative">
                  {%- if primary -%}
                    {{ primary | image_url: width: 800 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-105', widths: '300, 500, 800', sizes: '(min-width:1024px) 24vw, (min-width:640px) 45vw, 90vw', loading: 'lazy' }}
                  {%- endif -%}
                  {%- if secondary -%}
                    {{ secondary | image_url: width: 800 | image_tag: alt: detail_alt, class: 'object-cover absolute inset-0 w-full h-full opacity-0 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105', widths: '300, 500, 800', sizes: '(min-width:1024px) 24vw, (min-width:640px) 45vw, 90vw', loading: 'lazy' }}
                  {%- endif -%}
                </a>
                {%- if badge != blank -%}
                  <span class="absolute top-3 left-3 z-10 text-[9px] tracking-[.2em] uppercase font-medium px-2.5 py-1 rounded-sm shadow-sm" style="background: var(--black); color: var(--ivory)">{{ badge }}</span>
                {%- endif -%}
                <button type="button" data-wishlist-toggle="{{ product.handle }}" data-wishlist-idle="inherit" aria-label="Add to wishlist" aria-pressed="false" class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-white/80 backdrop-blur-md flex items-center justify-center shadow-sm transition-colors">♡</button>
              </div>

              <div class="space-y-1.5">
                {%- if material != blank -%}
                  <p class="text-[9px] tracking-widest uppercase font-medium" style="color: var(--gold-deep)">{{ material }}</p>
                {%- endif -%}
                <h3 class="serif text-2xl font-normal"><a href="{{ product.url }}" class="hover:opacity-70 transition-opacity">{{ product.title }}</a></h3>
                <div class="flex items-baseline gap-2 pt-0.5">
                  <span class="text-lg font-medium">{{ product.price | money_without_trailing_zeros }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <span class="text-xs opacity-40 line-through">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                  {%- endif -%}
                </div>
              </div>

              <button type="button" data-quick-add="{{ variant.id }}" {% unless product.available %}disabled{% endunless %} class="btn-luxury btn-gold-solid w-full mt-5 justify-center py-2.5 text-[11px] tracking-widest disabled:opacity-40"><span>+ Add To Bag</span></button>
            </div>
          {%- endfor -%}
        </div>
      </div>

      {%- if section.settings.button_label != blank -%}
        <div class="mt-20 text-center" data-reveal>
          <a href="{{ col.url }}" class="btn-luxury btn-gold"><span>{{ section.settings.button_label }}</span></a>
        </div>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="px-6 md:px-16 py-16 max-w-7xl mx-auto text-center text-sm opacity-60">
    Signature earrings: pick a collection with products (the import creates “earrings”).
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Signature earrings",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "01 / The Earrings Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Signature Earrings" },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Handcrafted icons in a premium anti tarnish finish, engineered to reflect light effortlessly with square precision frames."
    },
    {
      "type": "text",
      "id": "badges",
      "label": "Card badges (comma separated, cycled)",
      "default": "Anti Tarnish, Premium Finish, Handcrafted, Everyday Wear"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View Full Earrings Collection →" }
  ],
  "presets": [{ "name": "Signature earrings" }]
}
{% endschema %}
