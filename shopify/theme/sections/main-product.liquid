{% comment %}
  Product page — ported from frontend/src/app/product/[slug]/page.tsx.
  Breadcrumb, gallery (7 cols) + sticky purchase panel (5 cols); the
  accordions, related products, guarantee strip, reviews and notify-me modal
  are rendered below from their own snippets.
  No [data-reveal] wrappers here: the page has none on the live site, and the
  gallery lightbox / notify modal are position:fixed.
{% endcomment %}
{%- liquid
  assign eyebrow = product.metafields.custom.eyebrow.value
  assign crumb = collection
  if crumb == blank
    assign type_handle = product.type | handleize
    assign crumb = collections[type_handle]
  endif
-%}

<div class="pt-28"></div>
<div class="pb-24" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 mb-6 sm:mb-8 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs opacity-70">
    <nav aria-label="Breadcrumb" class="flex items-center gap-2">
      <a href="{{ routes.root_url }}" class="hover:opacity-100">Home</a>
      {%- if crumb.handle != blank -%}
        <span>/</span>
        <a href="{{ crumb.url }}" class="hover:opacity-100">{{ crumb.title }}</a>
      {%- elsif product.type != blank -%}
        <span>/</span>
        <span>{{ product.type }}</span>
      {%- endif -%}
      <span>/</span>
      <span class="opacity-100 font-medium" aria-current="page">{{ product.title }}</span>
    </nav>
    {%- if eyebrow != blank -%}
      <div class="flex items-center gap-2 text-[10px] tracking-[.25em] uppercase font-medium" style="color: var(--gold-deep)">
        <span class="w-2 h-2 rounded-full" style="background: var(--gold-deep)"></span>
        {{ eyebrow }}
      </div>
    {%- endif -%}
  </div>

  <section class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-start">
      <div class="lg:col-span-7">
        {% render 'product-gallery', product: product %}
        <div class="flex items-center justify-between gap-4 mt-4 p-4 sm:p-5 text-xs" style="background: rgba(239,233,222,.6); border: 1px solid rgba(216,183,126,.3)">
          <div class="flex items-center gap-3">
            <span class="text-xl">✨</span>
            <div>
              <p class="font-medium">{{ section.settings.finish_title }}</p>
              <p class="opacity-70 text-[11px] mt-0.5">{{ section.settings.finish_copy }}</p>
            </div>
          </div>
          <span class="text-[10px] tracking-widest uppercase font-medium shrink-0" style="color: var(--gold-deep)">{{ section.settings.finish_badge }}</span>
        </div>
      </div>
      <div class="lg:col-span-5 lg:sticky lg:top-28">
        {% render 'purchase-panel', product: product, tax_note: section.settings.tax_note %}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Product",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "tax_note",
      "label": "Note under the price",
      "default": "Inclusive of all taxes • Free Insured Delivery across India"
    },
    { "type": "text", "id": "finish_title", "label": "Finish strip title", "default": "Handfinished Premium Finish" },
    {
      "type": "text",
      "id": "finish_copy",
      "label": "Finish strip copy",
      "default": "Every piece is individually finished for luster and symmetry."
    },
    { "type": "text", "id": "finish_badge", "label": "Finish strip badge", "default": "Anti Tarnish" }
  ]
}
{% endschema %}
