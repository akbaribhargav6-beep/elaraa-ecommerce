NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://elaraa:elaraa_dev_password@localhost:5432/elaraa_ecommerce?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email — leave SMTP_*/RESEND_API_KEY blank in dev to auto-provision an
# Ethereal test account. In production, most hosts (Railway included) block
# outbound SMTP ports entirely, so set RESEND_API_KEY (resend.com) instead
# of SMTP_* — it sends over HTTPS and isn't affected by that block.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
MAIL_FROM="ELARAA <no-reply@elaraa.example>"
# Receives a notification email every time a new order is placed.
ADMIN_NOTIFICATION_EMAIL=elaraaluxes@gmail.com

# Upload storage. "local" writes to UPLOAD_DIR on the server's own disk —
# fine for local dev, but wiped on every redeploy on most PaaS hosts unless a
# persistent volume is attached. Set STORAGE_PROVIDER=cloudinary in
# production (free account at cloudinary.com) to store uploads permanently.
UPLOAD_DIR=uploads
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
