{% comment %}
  Quick View modal shell — ported from frontend/src/components/product/QuickViewModal.tsx.
  Rendered once per page (from sections/header.liquid); src/js/quick-view.mjs
  fills [data-qv-content] from /products/<handle>.js when a card asks for it.
{% endcomment %}
<div
  id="quickView"
  class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4"
  role="dialog"
  aria-modal="true"
  aria-label="Quick view"
  aria-hidden="true"
>
  <div class="bg-white max-w-2xl w-full rounded-sm shadow-2xl relative grid sm:grid-cols-2 max-h-[90vh] overflow-y-auto">
    <button
      type="button"
      data-qv-close
      aria-label="Close quick view"
      class="absolute top-4 right-4 z-10 w-9 h-9 rounded-full bg-white/90 flex items-center justify-center text-stone-600 hover:text-black shadow-md"
    >✕</button>
    <div data-qv-content class="contents"></div>
  </div>
</div>
