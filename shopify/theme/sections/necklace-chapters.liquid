{% comment %}
  The Necklace Chronicles — ported from the NECKLACE CHRONICLES block of
  frontend/src/app/page.tsx and components/home/NecklaceChapter.tsx.
  Alternating image/text rows labelled Chapter 01…04.
{% endcomment %}
{%- assign col = section.settings.collection -%}
{%- if col != blank and col.products_count > 0 -%}
  <section class="px-6 md:px-16 py-28 max-w-7xl mx-auto" data-section-id="{{ section.id }}">
    <div class="text-center max-w-3xl mx-auto mb-20" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="serif text-4xl md:text-6xl mt-4">{{ section.settings.heading }}</h2>
      <p class="mt-4 text-sm opacity-70 max-w-xl mx-auto leading-relaxed">{{ section.settings.copy }}</p>
    </div>

    <div class="space-y-24">
      {%- for product in col.products limit: section.settings.limit -%}
        {%- liquid
          assign primary = product.featured_image
          assign hover = product.images[2] | default: product.images[1]
          assign variant = product.selected_or_first_available_variant
          assign material = product.metafields.custom.material.value
          assign eyebrow = product.metafields.custom.eyebrow.value
          assign short_description = product.metafields.custom.short_description.value
          assign detail_alt = product.title | append: ' detail'
          assign reversed = forloop.index0 | modulo: 2
          assign chapter_number = forloop.index | prepend: '0' | slice: -2, 2
        -%}
        <div data-reveal>
          <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-14 items-center">
            <div class="md:col-span-7 group relative aspect-square bg-cream overflow-hidden rounded-sm border shadow-xl{% if reversed == 1 %} md:order-2{% endif %}" style="border-color: rgba(43,38,32,.12)">
              <a href="{{ product.url }}" class="block w-full h-full relative overflow-hidden">
                {%- if primary -%}
                  {{ primary | image_url: width: 1400 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:scale-105', widths: '600, 900, 1400', sizes: '(min-width:768px) 58vw, 100vw', loading: 'lazy' }}
                {%- endif -%}
                {%- if hover -%}
                  {{ hover | image_url: width: 1400 | image_tag: alt: detail_alt, class: 'object-cover absolute inset-0 w-full h-full opacity-0 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105', widths: '600, 900, 1400', sizes: '(min-width:768px) 58vw, 100vw', loading: 'lazy' }}
                {%- endif -%}
              </a>
              <span class="absolute top-4 {% if reversed == 1 %}right-4{% else %}left-4{% endif %} bg-white/90 backdrop-blur-md text-[10px] tracking-[.2em] uppercase px-3 py-1 font-medium">{{ section.settings.chapter_label }} {{ chapter_number }}</span>
            </div>

            <div class="md:col-span-5 space-y-4{% if reversed == 1 %} md:order-1{% endif %}">
              {%- comment -%} NecklaceChapter.tsx shows the material line only when the product has an eyebrow. {%- endcomment -%}
              {%- if eyebrow != blank and material != blank -%}
                <p class="text-[10px] tracking-[.25em] uppercase font-medium" style="color: var(--gold-deep)">{{ material }}</p>
              {%- endif -%}
              <h3 class="serif text-3xl sm:text-4xl"><a href="{{ product.url }}" class="hover:opacity-70 transition-opacity">{{ product.title }}</a></h3>
              {%- if short_description != blank -%}
                <p class="serif text-lg italic opacity-70 leading-relaxed font-light">&ldquo;{{ short_description }}&rdquo;</p>
              {%- endif -%}
              <div class="pt-2 flex items-baseline gap-3">
                <span class="text-2xl font-medium">{{ product.price | money_without_trailing_zeros }}</span>
                <span class="text-xs opacity-50">{{ section.settings.price_note }}</span>
              </div>
              <div class="pt-4 flex items-center gap-3">
                <button type="button" data-quick-add="{{ variant.id }}" {% unless product.available %}disabled{% endunless %} class="btn-luxury btn-gold-solid h-12 px-6 justify-center"><span>+ Add to Bag</span></button>
                <a href="{{ product.url }}" class="btn-luxury h-12 px-5 justify-center"><span>Explore Piece →</span></a>
              </div>
            </div>
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="mt-20 text-center" data-reveal>
        <a href="{{ col.url }}" class="btn-luxury btn-gold"><span>{{ section.settings.button_label }}</span></a>
      </div>
    {%- endif -%}
  </section>
{%- elsif request.design_mode -%}
  <section class="px-6 md:px-16 py-16 max-w-7xl mx-auto text-center text-sm opacity-60">
    Necklace chronicles: pick a collection with products (the import creates “necklaces”).
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Necklace chronicles",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Chapters", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Necklace Chronicles" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless Necklace Collection" },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Ethereal neckpieces with an anti tarnish finish, accented with luster pearls and crystal."
    },
    { "type": "text", "id": "chapter_label", "label": "Chapter label", "default": "Chapter" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "• Inclusive of insured courier" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore Complete Necklace Edit →" }
  ],
  "presets": [{ "name": "Necklace chronicles" }]
}
{% endschema %}
