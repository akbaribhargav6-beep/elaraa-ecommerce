{% comment %}
  "You May Also Like" — ported from the related-products block of
  frontend/src/app/product/[slug]/page.tsx.

  The page renders only the empty [data-related] root. src/js/related.mjs
  requests this same section from Shopify's recommendations endpoint (which
  fills `recommendations`) and swaps in [data-related-inner], which carries
  all the spacing — so a product with no recommendations leaves no gap.
  The root must never be display:none: related.mjs watches it with an
  IntersectionObserver, and hidden targets never intersect.
{% endcomment %}
<div
  data-related
  data-base="{{ routes.product_recommendations_url }}"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-limit="{{ section.settings.limit }}"
>
  {%- if recommendations.performed? and recommendations.products_count > 0 -%}
    <section class="max-w-7xl mx-auto px-4 sm:px-6 md:px-12 mt-24 sm:mt-32" data-related-inner>
      <div class="flex items-end justify-between mb-8 sm:mb-10">
        <div>
          <p class="eyebrow">{{ section.settings.eyebrow }}</p>
          <h2 class="serif text-3xl sm:text-4xl mt-1">{{ section.settings.heading }}</h2>
        </div>
      </div>
      <div class="flex gap-4 sm:gap-6 overflow-x-auto pb-4" style="scrollbar-width: thin">
        {%- for product in recommendations.products -%}
          {%- if product.tags contains 'hidden' -%}{%- continue -%}{%- endif -%}
          <div class="min-w-[220px] sm:min-w-[260px] max-w-[280px] flex-shrink-0">
            {% render 'product-card', product: product %}
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Related products",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Curated Complements" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "You May Also Like" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 10, "step": 1, "default": 6 }
  ],
  "enabled_on": {
    "templates": ["product"]
  },
  "presets": [{ "name": "Related products" }]
}
{% endschema %}
