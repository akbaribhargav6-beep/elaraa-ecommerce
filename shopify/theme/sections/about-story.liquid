{% comment %}
  About — "Act I · The Genesis" story block, ported from frontend/src/app/about/page.tsx.
{% endcomment %}
<section class="px-6 md:px-16 py-20 sm:py-28 border-b" style="border-color: rgba(43,38,32,.08)" data-section-id="{{ section.id }}">
  <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
    <div class="lg:col-span-5 relative" data-reveal>
      <div class="relative aspect-[4/5] overflow-hidden border shadow-xl" style="border-color: rgba(43,38,32,.12)">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1200 | image_tag: alt: section.settings.image_alt, class: 'absolute inset-0 w-full h-full object-cover', widths: '500, 800, 1200', sizes: '(min-width:1024px) 40vw, 100vw', loading: 'lazy' }}
        {%- else -%}
          <img src="https://res.cloudinary.com/nvausw3f/image/upload/v1786170505/products/luster/img-1.jpg" alt="{{ section.settings.image_alt | escape }}" width="800" height="1000" class="absolute inset-0 w-full h-full object-cover" loading="lazy">
        {%- endif -%}
      </div>
      {%- if section.settings.quote != blank -%}
        <div class="absolute -bottom-6 -right-4 sm:right-6 bg-white/90 backdrop-blur-md p-5 max-w-xs shadow-xl" style="border: 1px solid rgba(201,166,107,.4)">
          <p class="serif text-lg italic font-medium">&ldquo;{{ section.settings.quote }}&rdquo;</p>
          <p class="text-[10px] uppercase tracking-widest mt-2" style="color: var(--gold-deep)">{{ section.settings.quote_source }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="lg:col-span-7 space-y-8 lg:pl-6" data-reveal>
      <div>
        <p class="eyebrow mb-2">{{ section.settings.eyebrow }}</p>
        <h2 class="serif text-3xl sm:text-5xl leading-tight">{{ section.settings.heading }}</h2>
      </div>
      <div class="space-y-4 text-sm sm:text-base opacity-70 leading-relaxed">{{ section.settings.body }}</div>
      {%- if section.blocks.size > 0 -%}
        <div class="grid sm:grid-cols-2 gap-4 pt-4 border-t" style="border-color: rgba(43,38,32,.12)">
          {%- for block in section.blocks -%}
            <div class="flex items-start gap-3" {{ block.shopify_attributes }}>
              <span class="w-6 h-6 rounded-full flex items-center justify-center text-xs shrink-0 font-bold" style="background: rgba(168,130,61,.1); color: var(--gold-deep)" aria-hidden="true">✓</span>
              <div>
                <h3 class="serif text-lg font-medium">{{ block.settings.title }}</h3>
                <p class="text-xs opacity-60">{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About story",
  "tag": "div",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "ELARAA crafting" },
    { "type": "text", "id": "quote", "label": "Quote card", "default": "Purity is not a feature; it is our foundation." },
    { "type": "text", "id": "quote_source", "label": "Quote source", "default": "The ELARAA Philosophy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Act I · The Genesis" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reimagining Fashion Jewellery for Modern Life" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>For decades, the traditional jewellery industry forced women to choose between two extremes: overpriced boutiques with heavy markups for occasional wear, or low quality accessories that tarnish in weeks.</p><p>We set out to create a third way. Based in Jamnagar, Gujarat, a city with a craftsmanship tradition that runs generations deep, ELARAA was established to craft <strong>premium fashion jewellery with anti tarnish finishes</strong> designed to be lived in.</p><p>From morning coffees to formal galas, our creations combine architectural minimalism with everyday elegance.</p>"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Premium Finish & Anti Tarnish" },
        { "type": "text", "id": "body", "label": "Body", "default": "Skin friendly and built for daily wear." }
      ]
    }
  ],
  "presets": [{ "name": "About story", "blocks": [{ "type": "feature" }] }]
}
{% endschema %}
