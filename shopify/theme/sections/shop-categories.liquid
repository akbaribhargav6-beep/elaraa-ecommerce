{% comment %}
  "Shop by Category" circles — ported from the CATEGORIES block of
  frontend/src/app/page.tsx. One block per collection; the circle shows the
  block image, else the collection image, else the bundled category asset,
  else the collection's initial.
{% endcomment %}
<section class="px-6 md:px-16 py-20 max-w-6xl mx-auto text-center" data-section-id="{{ section.id }}">
  <div data-reveal><p class="eyebrow">{{ section.settings.eyebrow }}</p></div>
  <div class="mt-4 mb-14" data-reveal>
    <h2 class="serif text-4xl md:text-5xl">{{ section.settings.heading }}</h2>
  </div>
  <div class="flex flex-wrap justify-center gap-8 md:grid md:grid-cols-3 md:justify-items-center md:gap-x-16 md:gap-y-12">
    {%- for block in section.blocks -%}
      {%- liquid
        assign col = block.settings.collection
        if col == blank
          continue
        endif
        assign label = block.settings.label | default: col.title
        assign image = block.settings.image | default: col.image
        assign fallback = ''
        case col.handle
          when 'earrings'
            assign fallback = 'cat-ear.webp'
          when 'necklaces'
            assign fallback = 'cat-neck.webp'
          when 'rings'
            assign fallback = 'cat-ring.webp'
          when 'bracelets'
            assign fallback = 'cat-bracelet.webp'
        endcase
      -%}
      <div class="flex flex-col items-center group" data-reveal {{ block.shopify_attributes }}>
        <a href="{{ col.url }}" class="flex flex-col items-center">
          <div class="w-28 h-28 md:w-36 md:h-36 rounded-full overflow-hidden mb-4 transition-transform duration-500 group-hover:scale-105 flex items-center justify-center" style="border: 2px solid var(--gold); background: var(--cream)">
            {%- if image != blank -%}
              {{ image | image_url: width: 288, height: 288, crop: 'center' | image_tag: alt: label, class: 'w-full h-full object-cover', loading: 'lazy', widths: '144, 288' }}
            {%- elsif fallback != '' -%}
              <img src="{{ fallback | asset_url }}" alt="{{ label | escape }}" width="144" height="144" class="w-full h-full object-cover" loading="lazy">
            {%- else -%}
              <span class="serif text-3xl" style="color: var(--gold-deep)">{{ label | slice: 0 }}</span>
            {%- endif -%}
          </div>
          <span class="serif text-lg">{{ label }}</span>
        </a>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "tag": "div",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find Your Piece" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "label", "label": "Label", "info": "Defaults to the collection title." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Defaults to the collection image." }
      ]
    }
  ],
  "presets": [{ "name": "Shop by category", "blocks": [{ "type": "category" }, { "type": "category" }, { "type": "category" }] }]
}
{% endschema %}
