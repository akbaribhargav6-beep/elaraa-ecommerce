{% comment %}
  Best Sellers — ported from the BEST SELLERS block of frontend/src/app/page.tsx
  and components/home/BestSellersShowcase.tsx. Desktop: asymmetric 7/5 grid
  (hero card + three supporting cards). Mobile: swipeable carousel.
{% endcomment %}
{%- assign col = section.settings.collection -%}
{%- if col != blank and col.products_count > 0 -%}
  <section class="relative py-24 md:py-32 px-6 md:px-12 overflow-hidden" style="background: #F7F4EE" data-section-id="{{ section.id }}">
    <div class="max-w-7xl mx-auto relative z-10">
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 sm:mb-16" data-reveal>
        <div>
          <div class="flex items-center gap-3 mb-2">
            <span class="w-6 h-px" style="background: var(--gold-deep)"></span>
            <p class="eyebrow" style="color: var(--gold-deep)">{{ section.settings.eyebrow }}</p>
          </div>
          <h2 class="serif text-4xl sm:text-5xl md:text-6xl font-light leading-tight">{{ section.settings.heading }}</h2>
        </div>
        <div class="mt-4 md:mt-0 max-w-md">
          <p class="text-xs sm:text-sm opacity-70 leading-relaxed">{{ section.settings.copy }}</p>
        </div>
      </div>

      <div data-reveal>
        {%- comment -%} Desktop asymmetrical layout {%- endcomment -%}
        <div class="hidden md:grid grid-cols-12 gap-8 items-stretch">
          {%- for product in col.products limit: 1 -%}
            {%- liquid
              assign primary = product.featured_image
              assign secondary = product.images[1]
              assign variant = product.selected_or_first_available_variant
              assign material = product.metafields.custom.material.value
              assign detail_alt = product.title | append: ' detail'
            -%}
            <div class="md:col-span-7 group relative bg-white border rounded-sm p-8 flex flex-col justify-between overflow-hidden shadow-lg transition-all duration-700 hover:shadow-2xl" style="border-color: rgba(43,38,32,.12)">
              <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at top right, rgba(216,183,126,0.18) 0%, transparent 65%)"></div>
              <div class="relative z-10 flex items-center justify-between">
                <span class="text-[10px] tracking-[.25em] uppercase font-medium px-3 py-1 rounded-sm" style="background: var(--black); color: var(--ivory)">#1 Best Seller</span>
                <button type="button" data-wishlist-toggle="{{ product.handle }}" data-wishlist-idle="inherit" aria-label="Add to wishlist" aria-pressed="false" class="w-10 h-10 rounded-full bg-stone-100/80 backdrop-blur-md flex items-center justify-center shadow-sm transition-colors">♡</button>
              </div>

              <div class="relative w-full aspect-[4/3] my-6 overflow-hidden flex items-center justify-center">
                <a href="{{ product.url }}" class="w-full h-full block relative overflow-hidden">
                  {%- if primary -%}
                    {{ primary | image_url: width: 1200 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-all duration-700 group-hover:opacity-0 group-hover:scale-105', widths: '600, 900, 1200', sizes: '(min-width:768px) 45vw, 100vw', loading: 'lazy' }}
                  {%- endif -%}
                  {%- if secondary -%}
                    {{ secondary | image_url: width: 1200 | image_tag: alt: detail_alt, class: 'object-cover absolute inset-0 w-full h-full opacity-0 group-hover:opacity-100 transition-all duration-700 group-hover:scale-105', widths: '600, 900, 1200', sizes: '(min-width:768px) 45vw, 100vw', loading: 'lazy' }}
                  {%- endif -%}
                </a>
              </div>

              <div class="relative z-10 pt-4 border-t flex items-end justify-between gap-4" style="border-color: rgba(43,38,32,.12)">
                <div>
                  {%- if material != blank -%}
                    <p class="text-[10px] tracking-[.2em] uppercase font-medium" style="color: var(--gold-deep)">{{ material }}</p>
                  {%- endif -%}
                  <h3 class="serif text-2xl sm:text-3xl mt-0.5"><a href="{{ product.url }}" class="hover:opacity-70 transition-opacity">{{ product.title }}</a></h3>
                  <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-xl font-medium">{{ product.price | money_without_trailing_zeros }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="text-xs opacity-40 line-through">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                  </div>
                </div>
                <div class="flex items-center gap-2 shrink-0">
                  <button type="button" data-quick-add="{{ variant.id }}" {% unless product.available %}disabled{% endunless %} class="btn-luxury btn-gold-solid h-11 px-5 justify-center text-[11px] disabled:opacity-40"><span>Quick Add</span></button>
                  <a href="{{ product.url }}" aria-label="View {{ product.title | escape }}" class="w-11 h-11 border flex items-center justify-center text-lg hover:bg-black hover:text-white transition-colors" style="border-color: var(--black)">→</a>
                </div>
              </div>
            </div>
          {%- endfor -%}

          <div class="col-span-5 flex flex-col gap-6 justify-between">
            {%- for product in col.products limit: 3 offset: 1 -%}
              {%- liquid
                assign primary = product.featured_image
                assign secondary = product.images[1]
                assign variant = product.selected_or_first_available_variant
                assign material = product.metafields.custom.material.value
                assign detail_alt = product.title | append: ' detail'
              -%}
              <div class="group relative bg-white border rounded-sm p-4 sm:p-5 flex items-center gap-5 transition-all duration-500 hover:shadow-xl" style="border-color: rgba(43,38,32,.12)">
                <a href="{{ product.url }}" class="w-28 sm:w-32 aspect-square shrink-0 overflow-hidden relative rounded-sm bg-cream border" style="border-color: rgba(43,38,32,.1)">
                  {%- if primary -%}
                    {{ primary | image_url: width: 256 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-all duration-500 group-hover:opacity-0 group-hover:scale-105', sizes: '128px', loading: 'lazy' }}
                  {%- endif -%}
                  {%- if secondary -%}
                    {{ secondary | image_url: width: 256 | image_tag: alt: detail_alt, class: 'object-cover absolute inset-0 w-full h-full opacity-0 group-hover:opacity-100 transition-all duration-500 group-hover:scale-105', sizes: '128px', loading: 'lazy' }}
                  {%- endif -%}
                </a>
                <div class="flex-1 min-w-0">
                  <div class="flex items-center justify-between mb-1 gap-2">
                    {%- if material != blank -%}
                      <span class="text-[9px] tracking-widest uppercase font-medium truncate" style="color: var(--gold-deep)">{{ material }}</span>
                    {%- endif -%}
                    <button type="button" data-wishlist-toggle="{{ product.handle }}" data-wishlist-idle="inherit" aria-label="Add to wishlist" aria-pressed="false" class="text-sm shrink-0 transition-colors">♡</button>
                  </div>
                  <h3 class="serif text-xl truncate"><a href="{{ product.url }}" class="hover:opacity-70 transition-opacity">{{ product.title }}</a></h3>
                  <p class="text-sm font-medium mt-0.5">{{ product.price | money_without_trailing_zeros }}</p>
                  <div class="mt-3 flex items-center gap-3">
                    <button type="button" data-quick-add="{{ variant.id }}" {% unless product.available %}disabled{% endunless %} class="btn-luxury py-1.5 px-3.5 text-[10px] tracking-widest disabled:opacity-40"><span>+ Add To Bag</span></button>
                    <a href="{{ product.url }}" class="text-xs opacity-60 hover:opacity-100 underline underline-offset-4">Details</a>
                  </div>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>

        {%- comment -%} Mobile swipeable carousel {%- endcomment -%}
        <div class="flex md:hidden gap-4 overflow-x-auto snap-x snap-mandatory pb-6 pt-2 -mx-6 px-6">
          {%- for product in col.products limit: 4 -%}
            {%- assign material = product.metafields.custom.material.value -%}
            <div class="min-w-[85vw] snap-center bg-white border p-5 rounded-sm shadow-md" style="border-color: rgba(43,38,32,.12)">
              <div class="relative aspect-square overflow-hidden bg-cream mb-4 rounded-sm">
                {%- if forloop.first -%}
                  <span class="absolute top-2 left-2 z-10 text-[9px] uppercase tracking-widest px-2 py-0.5 font-medium" style="background: var(--black); color: var(--ivory)">#1 Best Seller</span>
                {%- endif -%}
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 800 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover', sizes: '85vw', widths: '400, 600, 800', loading: 'lazy' }}
                {%- endif -%}
              </div>
              {%- if material != blank -%}
                <p class="text-[10px] tracking-widest uppercase font-medium" style="color: var(--gold-deep)">{{ material }}</p>
              {%- endif -%}
              <h3 class="serif text-2xl mt-0.5">{{ product.title }}</h3>
              <p class="text-lg font-medium mt-1">{{ product.price | money_without_trailing_zeros }}</p>
              <a href="{{ product.url }}" class="btn-luxury btn-gold-solid w-full mt-4 justify-center py-3 text-xs"><span>View Product →</span></a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="px-6 md:px-16 py-16 max-w-7xl mx-auto text-center text-sm opacity-60">
    Best sellers: pick a collection with products (the import creates “best-sellers”).
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Best sellers showcase",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection", "info": "The first product is the large #1 card; the next three are supporting cards." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Best Sellers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Most Loved Collection" },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Our most coveted pieces, crafted in premium anti tarnish alloy and luster pearls, chosen repeatedly by our customers."
    }
  ],
  "presets": [{ "name": "Best sellers showcase" }]
}
{% endschema %}
