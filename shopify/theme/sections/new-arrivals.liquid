{% comment %}
  New Arrivals Spotlight — ported from the NEW ARRIVALS SPOTLIGHT block of
  frontend/src/app/page.tsx and components/home/NewArrivalsSpotlight.tsx.
  A "stage" on the left shows the active product; the list on the right
  selects it. Every stage panel is server-rendered and src/js/spotlight.mjs
  only toggles which one is visible, so it works in the theme editor too.
{% endcomment %}
{%- liquid
  assign col = section.settings.collection
  assign limit = section.settings.limit
  assign shown = col.products_count | at_most: limit
  assign total_label = shown | prepend: '0' | slice: -2, 2
-%}
{%- if col != blank and col.products_count > 0 -%}
  <section class="px-6 md:px-16 pb-28 max-w-7xl mx-auto" data-section-id="{{ section.id }}">
    <div class="flex flex-col md:flex-row md:items-end md:justify-between mb-14" data-reveal>
      <div>
        <p class="eyebrow">{{ section.settings.eyebrow }}</p>
        <h2 class="serif text-4xl md:text-5xl mt-4">{{ section.settings.heading }}</h2>
      </div>
      <a href="{{ col.url }}" class="text-xs tracking-[.2em] uppercase hover:opacity-60">{{ section.settings.link_label }}</a>
    </div>

    <div data-reveal>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center" data-spotlight>
        {%- comment -%} Featured stage: one panel per product, only the active one is shown {%- endcomment -%}
        <div class="lg:col-span-7">
          {%- for product in col.products limit: limit -%}
            {%- liquid
              assign variant = product.selected_or_first_available_variant
              assign eyebrow = product.metafields.custom.eyebrow.value
              assign short_description = product.metafields.custom.short_description.value
              assign index_label = forloop.index | prepend: '0' | slice: -2, 2
            -%}
            <div class="bg-white border rounded-sm p-6 sm:p-8 shadow-xl relative group{% unless forloop.first %} hidden{% endunless %}" style="border-color: rgba(43,38,32,.1)" data-spotlight-panel="{{ forloop.index0 }}">
              <div class="flex items-center justify-between mb-4 pb-3 border-b" style="border-color: rgba(43,38,32,.1)">
                <span class="text-[10px] tracking-[.25em] uppercase font-semibold" style="color: var(--gold-deep)">{{ index_label }} / {{ total_label }} New Edition</span>
                <span class="text-[9px] tracking-[.25em] font-bold text-white px-2.5 py-1 rounded-sm uppercase" style="background: #b45309">Just Landed</span>
              </div>

              <a href="{{ product.url }}" class="relative block w-full aspect-square overflow-hidden bg-cream rounded-sm mb-6 border" style="border-color: rgba(43,38,32,.08)">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 1200 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-105', widths: '600, 900, 1200', sizes: '(min-width:1024px) 50vw, 100vw', loading: 'lazy' }}
                {%- endif -%}
              </a>

              <div class="space-y-3">
                {%- if eyebrow != blank -%}
                  <p class="text-[10px] tracking-widest uppercase font-semibold" style="color: var(--gold-deep)">{{ eyebrow }}</p>
                {%- endif -%}
                <div class="flex items-baseline justify-between gap-4">
                  <h3 class="serif text-3xl sm:text-4xl font-normal">{{ product.title }}</h3>
                  <div class="flex items-baseline gap-2">
                    <span class="text-2xl font-medium">{{ product.price | money_without_trailing_zeros }}</span>
                    {%- if product.compare_at_price > product.price -%}
                      <span class="text-sm opacity-40 line-through">{{ product.compare_at_price | money_without_trailing_zeros }}</span>
                    {%- endif -%}
                  </div>
                </div>
                {%- if short_description != blank -%}
                  <p class="serif text-sm sm:text-base italic opacity-70 leading-relaxed">&ldquo;{{ short_description }}&rdquo;</p>
                {%- endif -%}

                <div class="pt-2 flex flex-col sm:flex-row gap-3">
                  <button type="button" data-quick-add="{{ variant.id }}" {% unless product.available %}disabled{% endunless %} class="btn-luxury btn-gold-solid flex-1 justify-center py-3.5 text-xs">
                    <span>Add {{ product.title }} to Bag: {{ product.price | money_without_trailing_zeros }}</span>
                  </button>
                  <a href="{{ product.url }}" class="btn-luxury py-3.5 px-6 text-xs"><span>View Product →</span></a>
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- comment -%} Selector list {%- endcomment -%}
        <div class="lg:col-span-5 flex flex-col gap-4">
          <div class="flex items-center justify-between mb-1">
            <p class="text-[10px] tracking-[.25em] uppercase font-semibold opacity-50">Select a New Arrival ({{ shown }})</p>
          </div>
          {%- for product in col.products limit: limit -%}
            {%- assign eyebrow = product.metafields.custom.eyebrow.value -%}
            <button
              type="button"
              data-spotlight-select="{{ forloop.index0 }}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
              class="text-left cursor-pointer border-2 rounded-sm p-4 flex items-center gap-4 transition-all duration-300"
              style="{% if forloop.first %}background: #fffbeb; border-color: #fbbf24{% else %}background: white; border-color: rgba(43,38,32,.1){% endif %}"
            >
              <div class="w-20 sm:w-24 aspect-square shrink-0 relative overflow-hidden rounded-sm bg-cream border" style="border-color: rgba(43,38,32,.08)">
                {%- if product.featured_image -%}
                  {{ product.featured_image | image_url: width: 192 | image_tag: alt: product.title, class: 'absolute inset-0 w-full h-full object-cover', sizes: '96px', loading: 'lazy' }}
                {%- endif -%}
              </div>
              <div class="flex-1 min-w-0">
                {%- if eyebrow != blank -%}
                  <span class="text-[9px] tracking-widest uppercase font-medium" style="color: var(--gold-deep)">{{ eyebrow }}</span>
                {%- endif -%}
                <h4 class="serif text-lg truncate font-medium">{{ product.title }}</h4>
                <p class="text-sm font-medium mt-0.5">{{ product.price | money_without_trailing_zeros }}</p>
              </div>
              <span class="text-xs font-bold shrink-0" data-spotlight-state style="{% if forloop.first %}color: #b45309{% else %}opacity: 0.4{% endif %}">{% if forloop.first %}★ Active{% else %}Select →{% endif %}</span>
            </button>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </section>
{%- elsif request.design_mode -%}
  <section class="px-6 md:px-16 py-16 max-w-7xl mx-auto text-center text-sm opacity-60">
    New arrivals: pick a collection with products (the import creates “new-arrivals”).
  </section>
{%- endif -%}

{% schema %}
{
  "name": "New arrivals spotlight",
  "tag": "div",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 6 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Latest Edit" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The New Collection" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View All →" }
  ],
  "presets": [{ "name": "New arrivals spotlight" }]
}
{% endschema %}
