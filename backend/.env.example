NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:3000

DATABASE_URL="postgresql://elaraa:elaraa_dev_password@localhost:5432/elaraa_ecommerce?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_dev_only
JWT_REFRESH_SECRET=change_me_refresh_secret_dev_only
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Email — leave SMTP_* blank in dev to auto-provision an Ethereal test account.
# Fill these in with a real provider (SendGrid, Gmail app password, etc.) to send real email.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ELARAA <no-reply@elaraa.example>"

# Local upload storage
UPLOAD_DIR=uploads
STORAGE_PROVIDER=local
