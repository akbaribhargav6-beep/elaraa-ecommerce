{% comment %}
  Create account — ported from frontend/src/app/(auth)/register/page.tsx.
  Shopify signs the customer in after a successful registration (there is no
  separate "check your email" step), and the optional phone is stored as a
  customer note because the registration form has no phone field.
{% endcomment %}
<div class="pt-28"></div>
<section class="px-6 pb-28 max-w-sm mx-auto" data-section-id="{{ section.id }}">
  <div class="text-center mb-10">
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h1 class="serif text-4xl mt-4">{{ section.settings.heading }}</h1>
  </div>
  {%- form 'create_customer', class: 'space-y-4', novalidate: 'novalidate' -%}
    <div class="grid grid-cols-2 gap-4">
      <input required type="text" name="customer[first_name]" autocomplete="given-name" placeholder="First name" aria-label="First name" value="{{ form.first_name | escape }}" class="border p-3 text-sm bg-transparent outline-none" style="border-color: rgba(43,38,32,.2)">
      <input type="text" name="customer[last_name]" autocomplete="family-name" placeholder="Last name" aria-label="Last name" value="{{ form.last_name | escape }}" class="border p-3 text-sm bg-transparent outline-none" style="border-color: rgba(43,38,32,.2)">
    </div>
    <input required type="email" name="customer[email]" autocomplete="email" placeholder="Email" aria-label="Email" value="{{ form.email | escape }}" class="w-full border p-3 text-sm bg-transparent outline-none" style="border-color: rgba(43,38,32,.2)">
    <input type="tel" name="customer[note][Phone]" autocomplete="tel" placeholder="Phone (optional)" aria-label="Phone (optional)" class="w-full border p-3 text-sm bg-transparent outline-none" style="border-color: rgba(43,38,32,.2)">
    <input required type="password" name="customer[password]" autocomplete="new-password" minlength="8" placeholder="Password (min 8 characters)" aria-label="Password" class="w-full border p-3 text-sm bg-transparent outline-none" style="border-color: rgba(43,38,32,.2)">
    {%- if form.errors -%}
      <div class="text-sm text-red-700" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <button type="submit" class="btn-luxury btn-gold-solid w-full justify-center"><span>Create Account</span></button>
  {%- endform -%}
  <p class="text-center text-xs opacity-60 mt-6">Already have an account? <a href="{{ routes.account_login_url }}" class="underline">Sign in</a></p>
</section>

{% schema %}
{
  "name": "Register",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join ELARAA" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Create Account" }
  ]
}
{% endschema %}
